<template>
  <div class="page" onswipe="swipe">
    <div if="{{mode === 'title' || mode === 'play'}}" class="art" style="height: {{mode === 'title' ? 204 : 240}}px;" onclick="advance">
      <image if="{{mode === 'title'}}" class="background" style="height:204px;" src="/common/title_bg.png" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{mode !== 'title'}}" class="background" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{bodySrc !== ''}}" class="body" style="width: {{portraitWidth}}px; height: {{portraitHeight}}px; top: {{portraitTop}}px; left: {{portraitLeft}}px;" src="{{bodySrc}}"></image>
      <image if="{{bodySecond !== ''}}" class="body" style="width: {{portraitSecondWidth}}px; height: {{portraitSecondHeight}}px; top: {{portraitSecondTop}}px; left: {{portraitSecondLeft}}px;" src="{{bodySecond}}"></image>
      <image if="{{bodyThird !== ''}}" class="body" style="width: {{portraitThirdWidth}}px; height: {{portraitThirdHeight}}px; top: {{portraitThirdTop}}px; left: {{portraitThirdLeft}}px;" src="{{bodyThird}}"></image>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <text class="title-text">纸上的魔法使</text>
      <text class="title-subtitle">{{progressLabel}}</text>
      <text class="title-action" onclick="startNew">开始游戏</text>
      <text class="title-action secondary" onclick="continueGame">读取存档</text>
      <text class="title-action secondary" onclick="openGallery">CG 鉴赏</text>
      <text class="title-action secondary" onclick="openRoutes">选择路线 / 章节</text>
      <text class="title-action exit-action" onclick="exitApplication">退出应用</text>
    </div>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <div class="speaker-row"><text if="{{speakerFont !== 'paperextra'}}" class="speaker">{{speaker}}</text><text if="{{speakerFont === 'paperextra'}}" class="speaker" style="font-family:paperextra;">{{speaker}}</text><text if="{{chapterFont !== 'paperextra'}}" class="chapter">{{chapterLabel}}</text><text if="{{chapterFont === 'paperextra'}}" class="chapter" style="font-family:paperextra;">{{chapterLabel}}</text></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="advance"><text if="{{dialogueFont !== 'paperextra'}}" class="dialogue" style="font-size: {{fontSize}}px;">{{displayText}}</text><text if="{{dialogueFont === 'paperextra'}}" class="dialogue" style="font-size: {{fontSize}}px;font-family:paperextra;">{{displayText}}</text></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <text class="choice-title">选择下一步</text>
      <scroll class="choice-list" scroll-y="true"><div for="{{options}}" tid="text"><text if="{{$item.font !== 'paperextra'}}" class="choice" onclick="pick($idx)">{{$item.text}}</text><text if="{{$item.font === 'paperextra'}}" class="choice" onclick="pick($idx)" style="font-family:paperextra;">{{$item.text}}</text></div></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action" onclick="saveGame">保存进度</text>
      <text class="menu-action" onclick="loadGame">读取进度</text>
      <text class="menu-action" style="color: {{hasNextChapter ? '#d5e5f2' : '#64758a'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action" onclick="resume">返回游戏</text>
      <text class="menu-action muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'routes' || mode === 'chapters'}}" class="full-panel">
      <text class="panel-title">{{browseTitle}}</text><text if="{{browseFont !== 'paperextra'}}" class="panel-subtitle">{{browseLabel}}</text><text if="{{browseFont === 'paperextra'}}" class="panel-subtitle" style="font-family:paperextra;">{{browseLabel}}</text>
      <div class="slot-list"><div for="{{browseRows}}" tid="key" class="slot-card" onclick="selectBrowse($idx)"><text if="{{$item.font !== 'paperextra'}}" class="slot-title">{{$item.name}}</text><text if="{{$item.font === 'paperextra'}}" class="slot-title" style="font-family:paperextra;">{{$item.name}}</text><text class="slot-meta">{{$item.detail}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousBrowse">‹ 上一页</text><text class="pager-action" onclick="closeBrowse">返回</text><text class="pager-action" onclick="nextBrowse">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#1d3549' : '#142535'}};" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><text if="{{$item.metaFont !== 'paperextra'}}" class="slot-meta">{{$item.meta}}</text><text if="{{$item.metaFont === 'paperextra'}}" class="slot-meta" style="font-family:paperextra;">{{$item.meta}}</text><text if="{{$item.previewFont !== 'paperextra'}}" class="slot-preview">{{$item.preview}}</text><text if="{{$item.previewFont === 'paperextra'}}" class="slot-preview" style="font-family:paperextra;">{{$item.preview}}</text>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <text if="{{overwriteFont !== 'paperextra'}}" class="confirm-text">{{overwriteDetail}}</text><text if="{{overwriteFont === 'paperextra'}}" class="confirm-text" style="font-family:paperextra;">{{overwriteDetail}}</text>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text if="{{$item.font !== 'paperextra'}}" class="gallery-caption">{{$item.label}}</text><text if="{{$item.font === 'paperextra'}}" class="gallery-caption" style="font-family:paperextra;">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text if="{{$item.font !== 'paperextra'}}" class="gallery-caption">{{$item.label}}</text><text if="{{$item.font === 'paperextra'}}" class="gallery-caption" style="font-family:paperextra;">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text if="{{cgFont !== 'paperextra'}}" class="cg-caption">{{cgLabel}}</text><text if="{{cgFont === 'paperextra'}}" class="cg-caption" style="font-family:paperextra;">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">{{endingLabel}}</text><text class="subtitle">可从标题选择其他篇章</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {newState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous,previewMap} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,createSave,slotRow} from '../../common/saves.js';
import {catalog} from '../../common/catalog.js';
import {imagePath} from '../../common/assets.js';
import {groupGallery,stepVariant} from '../../common/gallery.js';
import {textFont} from '../../common/text-font.js';
import {portraitBox} from '../../common/portrait-layout.js';
import {PROGRESS_KEY,emptyProgress,decodeProgress,progressFromState,withProgress} from '../../common/progress.js';
export default {
  private:{mode:'title',backgroundSrc:'/common/title_bg.png',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:144,portraitLeft:96,portraitSecondLeft:168,speaker:'',displayText:'',chapterLabel:'',speakerFont:'sans-serif',dialogueFont:'sans-serif',chapterFont:'sans-serif',browseFont:'sans-serif',overwriteFont:'sans-serif',cgFont:'sans-serif',
    options:[],loading:false,errorText:'',hasNextChapter:true,fontSize:22,textSpeed:30,speedLabel:'显示速度：逐字',fontLabel:'字号：标准',progressLabel:'手环 8 Pro · 测试版',
    portraitHeight:240,portraitTop:0,portraitSecondWidth:144,portraitSecondHeight:240,portraitSecondTop:0,portraitThirdWidth:112,portraitThirdHeight:240,portraitThirdTop:0,portraitThirdLeft:224,
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',endingLabel:'本篇阅读完毕',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:'',browseRows:[],browseTitle:'',browseLabel:'',browsePage:0},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this.loadSequence=0;this.timer=null;this.fullText='';this.resumeMode='play';
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=[];this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    this._progress=emptyProgress();this._progressWriteBusy=false;this._progressDirty=false;this._progressReady=false;this.loading=true;
    storage.get({complete:()=>{},key:'paper_band8pro_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===26?26:22;this.textSpeed=s.textSpeed===0?0:30;this.refreshSettings();}catch(e){}},fail:()=>{}});
    this.readProgress();
    console.log('PAPER_BAND8PRO title ready');
  },
  backgroundLoaded(){console.log('PAPER_BAND8PRO background loaded',this.mode,this.backgroundSrc);},
  backgroundError(){console.log('PAPER_BAND8PRO background failed',this.mode,this.backgroundSrc);},
  clearTyping(){if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  onShow(){this._hidden=false;if(this._chapterSkip&&this.timer===null)this.renderFrame();},
    onHide(){this._hidden=true;this.clearTyping();if(!this._chapterSkip&&this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;},
  readProgress(){this.loading=true;storage.get({complete:()=>{},key:PROGRESS_KEY,default:'',success:data=>{try{this._progress=decodeProgress(data);this._progressReady=true;this.refreshProgress();this.loading=false;}catch(e){this.fail(e.message);}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');}});},
  startNew(){if(this.loading||!this._progressReady)return;this.clearTyping();this.session=withProgress(newState(catalog.flowScene,true),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  refreshProgress(){this.progressLabel='手环 8 Pro · 测试版';},
  syncProgress(){
    if(!this._progressReady||this.session.progression!=='story')return;const progress=progressFromState(this.session);
    if(JSON.stringify(progress)===JSON.stringify(this._progress))return;
    this._progress=progress;this._progressDirty=true;this.refreshProgress();this.writeProgress();
  },
  writeProgress(){
    if(this._progressWriteBusy||!this._progressDirty)return;this._progressWriteBusy=true;this._progressDirty=false;
    const payload=JSON.stringify(this._progress);
    storage.set({complete:()=>{},key:PROGRESS_KEY,value:payload,success:()=>{this._progressWriteBusy=false;this.writeProgress();},fail:()=>{this._progressWriteBusy=false;this._progressDirty=true;this.toast('通关记录保存失败，请重试保存或返回标题');}});
  },
  openRoutes(){if(this.loading)return;this.clearTyping();this.mode='routes';this.browsePage=0;this.refreshBrowse();},
  visibleText(text){return String(text||'').replace(/・/g,'·');},
  characterName(name){return {'夜子':'游行寺夜子','理央':'伏见理央','妃':'月社妃','彼方':'日向彼方'}[name]||name;},
  visibleOptions(items){return items.map(item=>{const text=this.visibleText(item.text);return Object.assign({},item,{text,font:textFont(text)});});},
  refreshBrowse(){const routes=this.mode==='routes';this._browseItems=routes?catalog.routes:catalog.chapters.filter(x=>x.route===this._browseRoute);this.browseTitle=routes?'选择路线':'选择章节';const start=this.browsePage*4;this.browseRows=this._browseItems.slice(start,start+4).map((item,i)=>({key:(routes?'route:':'chapter:'+this._browseRoute+':')+(start+i),index:start+i,name:this.visibleText(item.name),font:textFont(item.name),detail:routes?item.scenes.length+' 个章节':'点击开始阅读'}));this.browseLabel=(routes?'章节阅读 · ':this.visibleText(catalog.routes[this._browseRoute].name)+' · ')+(this.browsePage+1)+' / '+Math.ceil(this._browseItems.length/4);this.browseFont=textFont(this.browseLabel);},
  previousBrowse(){if(this.browsePage>0){this.browsePage--;this.refreshBrowse();}},
  nextBrowse(){if(this.browsePage<Math.ceil(this._browseItems.length/4)-1){this.browsePage++;this.refreshBrowse();}},
  selectBrowse(row){const index=this.browsePage*4+row;if(this.mode==='routes'){this._browseRoute=index;this.browsePage=0;this.mode='chapters';this.refreshBrowse();return;}const item=this._browseItems[index];if(!item)return;this.session=withProgress(newState(item.id),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  closeBrowse(){if(this.mode==='chapters'){this.mode='routes';this.browsePage=Math.floor(this._browseRoute/4);this.refreshBrowse();}else this.toTitle();},
  continueGame(){this.openSlots('load');},
  readChapter(chapter,done){
    const block=Math.floor(this.session.cursor/512),key=chapter+':'+block;
    if(this.cachedChapter===key){done();return;}
    this.loading=true;const seq=++this.loadSequence;
    file.readText({complete:()=>{},uri:'/common/story/'+chapter+'/'+block+'.txt',success:data=>{
      if(seq!==this.loadSequence)return;
      try{const ops=JSON.parse(data.text);if(!Array.isArray(ops))throw new Error('章节格式无效');this.ops=ops;this.opsBase=block*512;this.cachedChapter=key;this.loading=!!this._chapterSkip;done();}
      catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this.loadSequence)this.fail('第 '+chapter+' 章读取失败：'+code+' '+String(data||'').slice(0,100));}});
  },
  renderFrame(){
    this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        const f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip,this.opsBase,catalog.scenes[String(this.session.chapter)].length):readFrame(this.ops,this.session,this.opsBase,catalog.scenes[String(this.session.chapter)].length);
        this.syncProgress();
        if(f.type==='jump'||f.type==='yield'){this._autoHops=(this._autoHops||0)+1;if(this._autoHops>1000)throw new Error('此章节无法继续，可从标题选择其他篇章');this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}this._autoHops=0;this._chapterSkip=null;this.loading=false;
        this.backgroundSrc=imagePath(this.session.background);
        const bodies=this.session.bodies||[];this.bodySrc=bodies[0]?imagePath(bodies[0]):'';this.bodySecond=bodies[1]?imagePath(bodies[1]):'';this.bodyThird=bodies[2]?imagePath(bodies[2]):'';
        const first=portraitBox(this.bodySrc,bodies.length,0),second=portraitBox(this.bodySecond,bodies.length,1),third=portraitBox(this.bodyThird,bodies.length,2);
        this.portraitWidth=first.width;this.portraitHeight=first.height;this.portraitTop=first.top;this.portraitLeft=first.left;
        this.portraitSecondWidth=second.width;this.portraitSecondHeight=second.height;this.portraitSecondTop=second.top;this.portraitSecondLeft=second.left;
        this.portraitThirdWidth=third.width;this.portraitThirdHeight=third.height;this.portraitThirdTop=third.top;this.portraitThirdLeft=third.left;
        this.chapterLabel=this.visibleText(catalog.scenes[String(this.session.rootChapter)].name);this.chapterFont=textFont(this.chapterLabel);this.hasNextChapter=!this.session.ended;
        if(f.type==='map'){this.renderMap(f);return;}
        if(f.type==='choice'){this.options=this.visibleOptions(f.items);this.mode='choice';console.log('PAPER_BAND8PRO choice',this.session.chapter,this.session.cursor);return;}
        if(f.type==='end'){this.mode='end';this.endingLabel=(catalog.endings[String(this.session.chapter)]||'本篇')+' · 阅读完毕';console.log('PAPER_BAND8PRO ending',this.session.chapter,this.endingLabel);return;}
        this.mode='play';this.speaker=this.characterName(this.visibleText(f.speaker));this.fullText=this.visibleText(f.text).replace(/(^|\n)[ \t\u3000]{3,}/g,'$1');this.speakerFont=textFont(this.speaker);this.dialogueFont=textFont(this.fullText);this.displayText='';
        try{this.$element('dialogue-scroll').scrollTo({index:0});}catch(e){}
        console.log('PAPER_BAND8PRO frame',this.session.chapter,this.session.cursor);
        if(this.textSpeed===0){this.displayText=this.fullText;return;}
        const tick=()=>{this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,this.textSpeed);else this.timer=null;};tick();
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this.mode!=='play')return;if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;return;}next(this.session);this.renderFrame();},
  renderMap(frame){this.loading=true;const seq=++this.loadSequence;file.readText({complete:()=>{},uri:'/common/map-preview.txt',success:data=>{if(seq!==this.loadSequence)return;try{const choices=previewMap(JSON.parse(data.text),this.session,frame);if(!choices.length)throw new Error('此地图阶段暂无支持的剧情选项，请返回标题选择其他篇章');this.options=this.visibleOptions(choices);this.mode='choice';this.loading=false;console.log('PAPER_BAND8PRO map ready',this.session.chapter,this.session.cursor,choices.map(x=>x.value).join(','));}catch(e){this.fail(e.message);}},fail:()=>{if(seq===this.loadSequence)this.fail('地图选项读取失败');}});},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('PAPER_BAND8PRO safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  goBack(){if(this.loading||this.mode!=='play')return;this.clearTyping();if(previous(this.session)){if(this.session.progression==='story')withProgress(this.session,this._progress);this.renderFrame();}else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('PAPER_BAND8PRO menu',this.session.chapter);},
  resume(){this.mode=this.resumeMode;},
  swipe(event){
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.writeProgress();this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.loading=true;
    const seq=++this._slotsSequence;this._slotData=Array(SLOT_COUNT).fill(null);
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('PAPER_BAND8PRO slots ready',role);};
    const finish=index=>{
      if(seq!==this._slotsSequence)return;
      if(index+1<SLOT_COUNT){setTimeout(()=>readSlot(index+1),0);return;}
      if(this._slotData[0]){ready();return;}
      storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSave(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});
    };
    const readSlot=i=>{if(seq!==this._slotsSequence)return;storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSave(data);}catch(e){this._slotData[i]={invalid:true};}finish(i);},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};finish(i);}});};
    readSlot(0);
  },
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows;this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.refreshSlotRows();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.refreshSlotRows();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this.loading=false;this.mode=this._slotsReturnMode;},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT)return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      try{this.session=restore(saved.state);if(this.session.progression==='story')withProgress(this.session,this._progress);this.cachedChapter=0;this._slotsSequence++;this.renderFrame();console.log('PAPER_BAND8PRO slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.toast(e.message);}return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.overwriteFont=textFont(this.overwriteDetail);this.mode='overwrite';console.log('PAPER_BAND8PRO overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData[index]=payload;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;
      this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('PAPER_BAND8PRO slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading)return;this.clearTyping();this.mode='gallery';
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.length;this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('PAPER_BAND8PRO gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,font:textFont(item.label+'张'),src:imagePath(item.image)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if(this.loading||index<0||index>=this._galleryCatalog.length)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=imagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');this.cgFont=textFont(this.cgLabel);console.log('PAPER_BAND8PRO cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';},
  refreshSettings(){this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===26?'字号：大':'字号：标准';},
  persistSettings(){storage.set({complete:()=>{},key:'paper_band8pro_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===22?26:22;this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this._chapterSkip=null;this.syncProgress();this.writeProgress();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.loading=false;this.mode='title';this.backgroundSrc='/common/title_bg.png';this.bodySrc='';this.bodySecond='';this.bodyThird='';if(!this._progressReady)this.readProgress();},
  exitApplication(){this.clearTyping();this._chapterSkip=null;this.loadSequence++;this._slotsSequence++;this._gallerySequence++;console.log('PAPER_BAND8PRO exit requested');this.$app.exit();},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.errorText=message;console.error('PAPER_BAND8PRO error',message);}
}
</script>
<style>
@font-face {font-family:paperextra;src:url('/common/paper-extra.otf');}
.page{width:336px;height:480px;background-color:#0a111f;flex-direction:column;}
.art{position:absolute;top:0px;left:0px;width:336px;height:240px;justify-content:center;align-items:center;background-color:#000000;}
.background{width:336px;height:240px;object-fit:contain;}
.body{position:absolute;top:0px;left:96px;width:144px;height:240px;object-fit:contain;}
.title-panel,.dialogue-panel,.choice-panel,.end-panel{position:absolute;top:240px;left:0px;width:336px;height:240px;flex-direction:column;padding:12px 16px;}
.title-panel{top:204px;height:276px;padding:8px 16px;background-color:#0a111f;}
.exit-action{background-color:#51333b;}
.title-text{height:32px;font-size:26px;color:#f4f7ff;text-align:center;margin-bottom:2px;}
.title-subtitle{height:20px;font-size:16px;color:#8d9cae;text-align:center;margin-bottom:4px;}
.title-action{height:34px;width:304px;margin-bottom:3px;color:#ffffff;background-color:#25445f;border-radius:10px;text-align:center;font-size:21px;}
.game-title{font-size:25px;color:#f4f7ff;text-align:center;margin-bottom:4px;}
.subtitle{font-size:18px;color:#8d9cae;text-align:center;margin-bottom:8px;}
.action{height:48px;width:304px;margin-bottom:6px;color:#ffffff;background-color:#25445f;border-radius:12px;text-align:center;font-size:22px;}
.secondary{background-color:#192b3d;}
.speaker-row{height:42px;width:304px;flex-direction:column;}
.speaker{height:25px;width:304px;font-size:22px;color:#9bdaed;}
.chapter{height:17px;width:304px;font-size:14px;color:#72849b;}
.dialogue-scroll{width:304px;height:132px;}
.dialogue{width:304px;color:#f4f7ff;line-height:32px;}
.toolbar{height:42px;width:304px;justify-content:space-between;align-items:center;}
.tool{font-size:19px;color:#b7cbdf;padding:7px;}
.choice-title{height:30px;font-size:22px;color:#b8dbe9;margin-bottom:8px;text-align:center;}
.choice{height:72px;width:304px;background-color:#25445f;border-radius:12px;font-size:21px;line-height:26px;color:#ffffff;text-align:center;margin-bottom:6px;}
.small-action{height:28px;font-size:19px;color:#9bacc0;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:336px;height:480px;background-color:#0a111f;flex-direction:column;padding:20px 24px;}
.menu-title{height:36px;font-size:26px;color:#ffffff;text-align:center;margin-bottom:12px;}
.menu-action{height:44px;font-size:21px;color:#d5e5f2;background-color:#172b3c;border-radius:12px;margin-bottom:8px;text-align:center;}
.muted{color:#98aabd;}
.full-panel{position:absolute;top:0px;left:0px;width:336px;height:480px;background-color:#0a111f;flex-direction:column;padding:14px 16px;}
.panel-title{height:32px;font-size:26px;color:#ffffff;text-align:center;margin-bottom:4px;}
.panel-subtitle{height:22px;font-size:15px;color:#93a8bc;text-align:center;margin-bottom:6px;}
.slot-list{height:336px;width:304px;flex-direction:column;}
.slot-card{height:76px;width:304px;margin-bottom:8px;padding:6px 10px;flex-direction:column;border-radius:12px;}
.slot-title{height:24px;font-size:20px;color:#e5f0fa;}
.slot-meta{height:17px;font-size:14px;color:#9ab2c7;}
.slot-preview{height:21px;font-size:16px;color:#bfceda;}
.pager{height:42px;width:304px;justify-content:space-between;align-items:center;}
.pager-action{font-size:18px;color:#b7cbdf;padding:6px;}
.gallery-row{height:168px;width:304px;justify-content:space-between;}
.gallery-card{height:160px;width:146px;padding:6px;flex-direction:column;background-color:#142535;border-radius:12px;}
.gallery-thumb{height:94px;width:134px;object-fit:contain;background-color:#000000;}
.gallery-caption{height:54px;width:134px;font-size:16px;line-height:20px;color:#d5e5f2;text-align:center;}
.cg-panel{position:absolute;top:0px;left:0px;width:336px;height:480px;flex-direction:column;background-color:#000000;}
.cg-image{width:336px;height:398px;object-fit:contain;}
.cg-caption{width:336px;height:28px;font-size:17px;color:#d5e5f2;text-align:center;}
.cg-controls{width:336px;height:54px;padding:0px 6px;justify-content:space-between;align-items:center;background-color:#0a111f;}
.confirm-text{font-size:21px;color:#d5e5f2;margin:24px 0px;}
.error-text{font-size:21px;color:#eab7b7;margin-bottom:24px;}
.loading{position:absolute;top:214px;left:88px;width:160px;height:44px;text-align:center;font-size:22px;color:#ffffff;background-color:#253a50;border-radius:12px;}
.choice-panel{top:0px;height:480px;background-color:#0a111f;padding:16px;}
.choice-list{width:304px;height:370px;flex-direction:column;}
</style>
